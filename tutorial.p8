pico-8 cartridge // http://www.pico-8.com
version 42
__lua__

function _init()
    #include player_functions.p8
    cartdata("r8cer_costello")
    menuitem(1, "save", function() save() end)
    menuitem(2, "load", function() load_save() end)
    menuitem(3, "main menu",function() load("mainmenu.p8") end)
    menuitem(4, "reset save data", function() reset_save() end)
    dset(1, 12)
    player_init()
    if dget(2) == 1 then
        dset(2, 0)
        load_save()
    end
    max_checkpoints = 1
    time_to_beat = 10
    dset(10, 1)
end

function _update()
    player_update()
end

function _draw()
    player_draw()
    create_prints()
    pal(2, 130, 1)
end

function create_prints()
    --⬇️ ⬆️ ⬅️ ➡️
    local line = "the line coming out of your"
    local line2 = "car is the direction it"
    local line3 = "will go when accelerating"
    local start_line = "this is the start of the race"
    local start_line2 = "cross it to reset the timer"
    local p_f = "press ⬆️ to accelerate"
    local p_b = "press ⬇️ to reverse"
    local turn = "press ⬅️/➡️ to turn left/right"
    local booster = "this is a booster"
    local booster2 = "it gives you a speed boost"
    local grass = "grass (behind this)"
    local grass2 = "slows you down"
    local cp = "this is a checkpoint"
    local cp2 = "collect them all"
    local cp3 = "to cross the finish line"
    local fin = "this is the finish line"
    local fin2 = "although some tracks will"
    local fin3 = "finish where you started"
    print(start_line, 80 - #start_line*2, 64, 12)
    print(start_line2, 80 - #start_line2*2, 72, 12)
    print(p_f, 80 - #p_f*2, 97, 12)
    print(p_b, 80 - #p_b*2, 105, 12)
    print(turn, 80 - #turn*2, 113, 12)
    print(grass, 17, 129, 12)
    print(grass2, 17 + #grass/2, 137, 12)
    print(booster, 17 + #booster2/1.5, 153, 12)
    print(booster2, 17, 161, 12)
    print(line, 17, 206, 12)
    print(line2, 17, 214, 12)
    print(line3, 17, 222, 12)
    print(cp, 112 - #cp*2, 232, 12)
    print(cp2, 112 - #cp2*2, 240, 12)
    print(cp3, 112 - #cp3*2, 248, 12)
    print(fin, 172 - #fin*2, 184, 12)
    print(fin2, 172 - #fin2*2, 192, 12)
    print(fin3, 172 - #fin3*2, 200, 12)
end

