pico-8 cartridge // http://www.pico-8.com
version 42
__lua__

--export -i 6 r8-cer.bin mainmenu.p8 player_functions.p8 race1.p8 race2.p8 race3.p8 race4.p8 race5.p8 race6.p8 race7.p8 race8.p8 race9.p8 race10.p8 tutorial.p8

function _init()
    #include player_functions.p8
    poke(0x5F2D, 1)
    cartdata("r8cer_costello")
    --play is 54, 32 to 75, 40
    --races is 53, 56 to 75, 72
    --quit is 53, 80 to 75, 96
    btn_map_x = 0
    map_x = 0
    player_init()
    max_checkpoints = 4
    time_to_beat = 30
    last_click = 0
    draw_nums = false
    nums_spr = 64
    min_nums_spr = 64
    max_nums_spr = 73
    version = "demo v-0.6.8"
end

function _update()
    choose_button()
end

function _draw()
    cls()
    if map_x > 35 then
        map_x = 1
    else
        map_x += 0.2
    end
    map(map_x, 18, 0, 0)
    spr(2, 16, 60, 1, 1, true)
    pal(2, 130, 1)
    map(btn_map_x, btn_map_y, 0, 0)
    if draw_nums then
        spr(nums_spr, 60, 56)
    end
    spr(48, stat(32)-1, stat(33)-1)
    print(version, 64 - #version*2, 122, 12)
end

function choose_button()
    local levels = {"race1.p8","race2.p8","race3.p8", "race4.p8", "race5.p8", "race6.p8", "race7.p8", "race8.p8", "race9.p8", "race10.p8","mainmenu.p8"}
    local mouse_x = stat(32)
    local mouse_y = stat(33)
    if btn_map_x < 72 then
        draw_nums = false
        --check if we are in the select menu or not, if we are do something else
        if mouse_y > 32 and mouse_y < 48 and mouse_x > 53 and mouse_x < 75 then
            --play button
            btn_map_x = 18
            if stat(34) == 1 then
                sfx(1,3)
                local j = 1
                for i = 1,dget(1) do
                    j = i
                end
                if j == #levels then 
                    j = 1 
                end
                if dget(10) == 0 then
                    load("tutorial.p8")
                else
                    load(levels[j])
                end
            end
        elseif mouse_y > 56 and mouse_y < 72 and mouse_x > 53 and mouse_x < 75 then
            --races button
            btn_map_x = 36
            if stat(34) == 1 then
                sfx(1,3)
                btn_map_x = 72
            end
        elseif mouse_y > 80 and mouse_y < 96 and mouse_x > 53 and mouse_x < 75 then
            --select button
            btn_map_x = 54
            if stat(34) == 1 and time() - last_click > 1 then
                sfx(1,3)
                stop()
            end
        else
            btn_map_x = 0
        end
    else
        --the something else
        draw_nums = true
        if mouse_y > 80 and mouse_y < 96 and mouse_x > 53 and mouse_x < 75 then
            --back button
            btn_map_x = 90
            btn_map_y = 0
            if stat(34) == 1 then
                sfx(1,3)
                btn_map_x = 54
                last_click = time()
            end
        elseif mouse_y > 56 and mouse_y < 64 and mouse_x > 40 and mouse_x < 48 then
            --left arrow button
            btn_map_x = 108
            btn_map_y = 18
            if stat(34) == 1 and nums_spr > min_nums_spr and time() - last_click > 0.1 then
                sfx(1,3)
                nums_spr -= 1
                last_click = time()
            end
        elseif mouse_y > 56 and mouse_y < 64 and mouse_x > 80 and mouse_x < 88 then
            --right arrow button
            btn_map_x = 108
            btn_map_y = 0
            if stat(34) == 1 and nums_spr < max_nums_spr and time() - last_click > 0.1 then
                nums_spr += 1
                last_click = time()
                sfx(1,3)
            end
        elseif mouse_y > 32 and mouse_y < 48 and mouse_x > 53 and mouse_x < 75 then
            --play button
            btn_map_x = 90
            btn_map_y = 18
            if stat(34) == 1 then
                sfx(1,3)
                load(levels[nums_spr - min_nums_spr + 1])
            end
        else
            btn_map_x = 72
            btn_map_y = 0
        end
    end
end

